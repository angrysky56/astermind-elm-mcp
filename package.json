{
  "name": "astermind-elm-mcp",
  "version": "1.0.0",
  "description": "MCP server for AsterMind-ELM: Fast, on-device machine learning with Extreme Learning Machines",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && npm run typecheck:tests && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run build && npm run typecheck:tests && vitest run --coverage",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "init-db": "node build/scripts/init-db.js"
  },
  "keywords": [
    "mcp",
    "machine-learning",
    "elm",
    "extreme-learning-machine",
    "classification",
    "embeddings",
    "on-device-ml"
  ],
  "author": "AI Workspace",
  "license": "MIT",
  "dependencies": {
    "@astermind/astermind-elm": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "surrealdb": "^1.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
